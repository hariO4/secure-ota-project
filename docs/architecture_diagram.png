</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">with</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">open</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>private_key_path</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"rb"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">as</span><span> f</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
