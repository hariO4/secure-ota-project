oken" style="color: rgb(155, 233, 99);">"
</span></span><span class="token token" style="color: rgb(155, 233, 99);">with open('temp_pub.pem', 'rb') as f:
</span><span class="token token" style="color: rgb(155, 233, 99);">    a = f.read()
</span><span class="token token" style="color: rgb(155, 233, 99);">with open('public_key.pem', 'rb') as f:
