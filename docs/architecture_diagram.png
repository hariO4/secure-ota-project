ers</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>ASUS</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>secure-ota-project</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>firmware</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>secure_ota_device.bin C:</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>Users</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>ASUS</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>secure-ota-project</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>server</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>keys</span><span class="token token" style="color: rgb(211, 215, 222);">\</span><span>secure_ota_device.bin
