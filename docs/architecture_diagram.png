</span></span><span>
</span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">def</span><span> </span><span class="token token" style="color: rgb(112, 184, 255);">sign_firmware</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>firmware_path</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> private_key_path</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> output_sig_path</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);"># Read firmware binary</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">with</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">open</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>firmware_path</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"rb"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">as</span><span> f</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        firmware_data </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> f</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>read</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
